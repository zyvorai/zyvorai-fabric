{
  "kind": "usecase",
  "name": "card-statement",
  "title": "Card statement",
  "description": "Drop in a card or bank statement CSV and get the most common categories and merchants and the first rows.",
  "accepts": [
    "csv"
  ],
  "extract": "text",
  "summary": [
    {
      "kind": "csv_columns",
      "title": "Where it goes",
      "columns": [
        "category",
        "description"
      ],
      "top": 5
    },
    {
      "kind": "table",
      "title": "First rows",
      "max_rows": 10
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "statement.md",
  "sample_file": "sample.csv"
}
