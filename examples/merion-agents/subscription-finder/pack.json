{
  "kind": "usecase",
  "name": "subscription-finder",
  "title": "Subscription finder",
  "description": "Drop in a mail export and find renewals, trials that end, what will be charged and the amounts.",
  "accepts": [
    "mbox",
    "eml"
  ],
  "extract": "eml",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Renewals",
      "keywords": [
        "renews",
        "renewal",
        "auto-renew"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Trials",
      "keywords": [
        "free trial",
        "trial ends",
        "trial"
      ],
      "max_lines": 6
    },
    {
      "kind": "keyword_sections",
      "title": "Charges",
      "keywords": [
        "will be charged",
        "charged",
        "billed"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|USD|EUR|GBP|\\$|€|£)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 12
    },
    {
      "kind": "regex_extract",
      "title": "Who is charging",
      "pattern": "From: .*?<([^>]+)>",
      "max_matches": 8,
      "group": 1
    }
  ],
  "artifact_title": "subscriptions.md",
  "sample_file": "sample.mbox"
}
