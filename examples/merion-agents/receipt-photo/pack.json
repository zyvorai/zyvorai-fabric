{
  "kind": "usecase",
  "name": "receipt-photo",
  "title": "Receipt photo",
  "description": "Drop in a photo or screenshot of a receipt and get the totals, dates, warranty or return lines and every amount seen.",
  "accepts": [
    "png",
    "jpg",
    "jpeg",
    "tiff"
  ],
  "extract": "ocr",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Totals",
      "keywords": [
        "total",
        "amount paid",
        "subtotal",
        "tax",
        "vat",
        "gst"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b|\\b[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4}\\b",
      "max_matches": 8
    },
    {
      "kind": "regex_extract",
      "title": "Dates written with a month name",
      "pattern": "\\b(?:[0-9]{1,2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]* [0-9]{1,2})\\b",
      "max_matches": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Warranty and returns",
      "keywords": [
        "warranty",
        "guarantee",
        "return by",
        "returns accepted",
        "refund"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Items and order",
      "keywords": [
        "order",
        "item",
        "qty",
        "invoice",
        "receipt",
        "bill no"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|USD|EUR|GBP|\\$|€|£)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 10
    }
  ],
  "artifact_title": "receipt.md"
}
