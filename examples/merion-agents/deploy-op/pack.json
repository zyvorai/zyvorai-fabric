{
  "kind": "agent",
  "name": "deploy-op",
  "manifest": {
    "template": "agent-node",
    "resources": {
      "vcpus": 1,
      "memory_mib": 1024
    },
    "egress_mode": "ask",
    "egress_allow_hosts": [
      "127.0.0.1"
    ],
    "egress_approval_timeout_seconds": 90,
    "allow_private_networks": true,
    "credentials": [
      "fabric-api"
    ],
    "confinement": "strict",
    "taint": {
      "trusted_hosts": [
        "127.0.0.1"
      ]
    }
  },
  "goal": {
    "title": "Probe readiness",
    "text": "Probe /readyz and /health and report; the operator runs any install commands."
  }
}
