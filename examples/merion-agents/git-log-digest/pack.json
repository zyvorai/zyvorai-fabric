{
  "kind": "usecase",
  "name": "git-log-digest",
  "title": "Git log digest",
  "description": "Drop in `git log` output in a pipe-separated format and get commits per author and month, commit-type prefixes and the merge count.",
  "accepts": [
    "txt",
    "log"
  ],
  "extract": "text",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "Commits per author",
      "pattern": "(?m)^[0-9a-f]{7,40}\\|([^|]+)\\|",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Commits per month",
      "pattern": "\\|([0-9]{4}-[0-9]{2})-[0-9]{2}\\|",
      "max_matches": 12,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Commit prefixes",
      "pattern": "\\|[0-9]{4}-[0-9]{2}-[0-9]{2}\\|([a-z]+)(?:\\([^)]*\\))?!?:",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "keyword_sections",
      "title": "Merge commits",
      "keywords": [
        "merge pull request",
        "merge branch"
      ],
      "max_lines": 6
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "git-log-digest.md",
  "sample_file": "sample.txt"
}
