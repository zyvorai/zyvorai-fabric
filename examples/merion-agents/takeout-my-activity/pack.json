{
  "kind": "usecase",
  "name": "takeout-my-activity",
  "title": "Google activity",
  "description": "Drop in the My Activity JSON from Google Takeout and see which Google products you used most, what you did, and the first entries.",
  "accepts": [
    "json"
  ],
  "extract": "text",
  "sample_file": "MyActivity.json",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "Products (most used first)",
      "pattern": "\"header\":\\s*\"([^\"]{1,40})\"",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "What you did",
      "pattern": "\"title\":\\s*\"([^\"]{3,100})\"",
      "max_matches": 15,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\"time\":\\s*\"([0-9]{4}-[0-9]{2}-[0-9]{2})",
      "max_matches": 8,
      "group": 1
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "activity.md"
}
