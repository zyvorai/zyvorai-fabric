{
  "kind": "usecase",
  "name": "loan-sanction-letter",
  "title": "Loan sanction letter",
  "description": "Drop in a sanction letter PDF and get the sanction terms, conditions, charges, amounts, rates and dates, each quoted from the letter.",
  "accepts": [
    "pdf"
  ],
  "extract": "pdftotext",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Sanction terms",
      "keywords": [
        "sanctioned",
        "loan amount",
        "rate of interest",
        "tenure",
        "emi",
        "processing fee",
        "moratorium"
      ],
      "max_lines": 10
    },
    {
      "kind": "keyword_sections",
      "title": "Conditions and covenants",
      "keywords": [
        "condition",
        "covenant",
        "prior to disbursement",
        "security",
        "collateral",
        "guarantor"
      ],
      "max_lines": 10
    },
    {
      "kind": "keyword_sections",
      "title": "Charges and penalties",
      "keywords": [
        "penal",
        "prepayment",
        "foreclosure",
        "late payment",
        "bounce"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|₹)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 12
    },
    {
      "kind": "regex_extract",
      "title": "Rates",
      "pattern": "[0-9]{1,2}(?:\\.[0-9]{1,2})?\\s?%",
      "max_matches": 8
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{2}[-/][0-9]{2}[-/][0-9]{2,4}\\b",
      "max_matches": 8
    }
  ],
  "artifact_title": "sanction-terms.md"
}
