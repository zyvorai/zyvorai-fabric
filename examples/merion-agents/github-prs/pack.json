{
  "kind": "usecase",
  "name": "github-prs",
  "title": "GitHub pull requests",
  "description": "Drop in `gh pr list --json` output and get states, authors, labels, merges per month and the titles.",
  "accepts": [
    "json"
  ],
  "extract": "text",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "By state",
      "pattern": "\"state\":\"(\\w+)\"",
      "max_matches": 5,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Authors",
      "pattern": "\"login\":\"([^\"]+)\"",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Labels",
      "pattern": "\"id\":\"LA_[^\"]*\",\"name\":\"([^\"]+)\"",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Merged per month",
      "pattern": "\"mergedAt\":\"(\\d{4}-\\d{2})-\\d{2}",
      "max_matches": 12,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Titles",
      "pattern": "\"title\":\"([^\"]+)\"",
      "max_matches": 15,
      "group": 1
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "github-prs.md",
  "sample_file": "sample.json"
}
