{
  "kind": "usecase",
  "name": "fuel-receipt-photo",
  "title": "Fuel receipt photo",
  "description": "Drop in a photo of a fuel-station receipt and get the litres, the rate, the total and the date.",
  "accepts": [
    "png",
    "jpg",
    "jpeg",
    "tiff"
  ],
  "extract": "ocr",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Fuel",
      "keywords": [
        "litre",
        "ltr",
        "volume",
        "quantity",
        "rate",
        "price",
        "petrol",
        "diesel",
        "cng"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Total",
      "keywords": [
        "total",
        "amount",
        "sale"
      ],
      "max_lines": 4
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4}\\b|\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b",
      "max_matches": 4
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|USD|EUR|GBP|\\$|€|£|₹)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?|[0-9][0-9,]*\\.[0-9]{2}",
      "max_matches": 10
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "fuel.md"
}
