{
  "kind": "usecase",
  "name": "insurance-claim-mail",
  "title": "Insurance claim mail",
  "description": "Drop in claim emails from your insurer and see the claim numbers, status, amounts, dates and what they still need from you.",
  "accepts": [
    "eml",
    "mbox"
  ],
  "extract": "eml",
  "sample_file": "claims.mbox",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "Claim numbers",
      "pattern": "(?i)claim (?:no\\.?|number|id)[:# ]*([A-Z0-9][A-Z0-9/-]{4,19})",
      "max_matches": 6,
      "group": 1
    },
    {
      "kind": "keyword_sections",
      "title": "Status",
      "keywords": [
        "approved",
        "rejected",
        "declined",
        "pending",
        "under review",
        "settled",
        "cashless",
        "reimbursement"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "What they need from you",
      "keywords": [
        "please submit",
        "please upload",
        "additional document",
        "more information",
        "within",
        "deadline",
        "reply"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|USD|EUR|GBP|\\$|€|£|₹)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 8
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4}\\b|\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b",
      "max_matches": 6
    },
    {
      "kind": "regex_extract",
      "title": "Subjects",
      "pattern": "(?m)^Subject: (.+)$",
      "max_matches": 8,
      "group": 1
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "claims.md"
}
