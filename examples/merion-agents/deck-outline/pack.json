{
  "kind": "usecase",
  "name": "deck-outline",
  "title": "Deck outline",
  "description": "Drop in a PowerPoint (.pptx) and get the slide count, amounts, dates, open points, action lines and the speaker notes.",
  "accepts": [
    "pptx"
  ],
  "extract": "pptx",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "Slides",
      "pattern": "# Deck: ([0-9]+ slides?)",
      "group": 1,
      "max_matches": 1
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:₹|Rs\\.?|INR|USD|EUR|GBP|\\$|€|£)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?|[0-9][0-9,]*(?:\\.[0-9]{2})?\\s?(?:EUR|USD|INR|GBP|Rs|dollars|euros|pounds|rupees|lakh|crore)\\b",
      "max_matches": 15
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{1,2}[/.-][0-9]{1,2}[/.-][0-9]{2,4}\\b|\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b",
      "max_matches": 12
    },
    {
      "kind": "regex_extract",
      "title": "Dates written with a month name",
      "pattern": "\\b(?:[0-9]{1,2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]* [0-9]{1,2})\\b",
      "max_matches": 12
    },
    {
      "kind": "keyword_sections",
      "title": "Open points",
      "keywords": [
        "tbd",
        "todo",
        "to be confirmed",
        "confidential",
        "draft",
        "placeholder"
      ],
      "max_lines": 12
    },
    {
      "kind": "keyword_sections",
      "title": "Actions and owners",
      "keywords": [
        "action",
        "next step",
        "owner",
        "deadline",
        "by friday"
      ],
      "max_lines": 12
    },
    {
      "kind": "keyword_sections",
      "title": "Speaker notes",
      "keywords": [
        "notes:"
      ],
      "max_lines": 20
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "deck-outline.md"
}
