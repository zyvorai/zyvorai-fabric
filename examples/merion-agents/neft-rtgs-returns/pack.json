{
  "kind": "usecase",
  "name": "neft-rtgs-returns",
  "title": "NEFT / RTGS returns",
  "description": "Drop in a returns or rejects report and get the returned lines, beneficiary problems, UTRs, IFSCs and amounts.",
  "accepts": [
    "txt",
    "csv"
  ],
  "extract": "text",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Returned or rejected",
      "keywords": [
        "returned",
        "rejected",
        "failed"
      ],
      "max_lines": 12
    },
    {
      "kind": "keyword_sections",
      "title": "Beneficiary problems",
      "keywords": [
        "account closed",
        "does not exist",
        "invalid ifsc",
        "name mismatch",
        "frozen",
        "dormant"
      ],
      "max_lines": 10
    },
    {
      "kind": "regex_extract",
      "title": "UTRs",
      "pattern": "\\b[A-Z]{4}[RNH][0-9]{10,17}\\b",
      "max_matches": 15
    },
    {
      "kind": "regex_extract",
      "title": "IFSCs",
      "pattern": "\\b[A-Z]{4}0[A-Z0-9]{6}\\b",
      "max_matches": 10
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:Rs\\.?|INR|₹)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 12
    }
  ],
  "artifact_title": "returns.md",
  "sample_file": "sample.txt"
}
