{
  "kind": "usecase",
  "name": "reimbursement-claims",
  "title": "Reimbursement claims from mail",
  "description": "Drop in a mail export and list who claimed, the amounts, what is approved, pending, paid or declined, and the categories.",
  "accepts": [
    "mbox",
    "eml"
  ],
  "extract": "eml",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "Who is asking",
      "pattern": "From: .*?<([^>]+)>",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:₹|Rs\\.?|INR|USD|EUR|GBP|\\$|€|£)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 15
    },
    {
      "kind": "keyword_sections",
      "title": "Approved or paid",
      "keywords": [
        "approved",
        "paid on",
        "reimbursed",
        "credited"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Pending or declined",
      "keywords": [
        "pending",
        "awaiting",
        "declined",
        "rejected",
        "not eligible",
        "need the receipt"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Categories",
      "keywords": [
        "cab",
        "taxi",
        "uber",
        "flight",
        "hotel",
        "meal",
        "client dinner",
        "fuel",
        "internet",
        "phone bill"
      ],
      "max_lines": 10
    }
  ],
  "artifact_title": "reimbursements.md",
  "sample_file": "sample.mbox"
}
