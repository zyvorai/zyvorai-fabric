{
  "kind": "usecase",
  "name": "inventory-sheet",
  "title": "Inventory sheet",
  "description": "Drop in an Excel stock sheet and see rows per location and the first rows.",
  "accepts": [
    "xlsx"
  ],
  "extract": "xlsx",
  "summary": [
    {
      "kind": "csv_columns",
      "title": "Locations",
      "columns": [
        "location"
      ],
      "top": 10
    },
    {
      "kind": "table",
      "title": "First rows",
      "max_rows": 15
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "inventory.md"
}
