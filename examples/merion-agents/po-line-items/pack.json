{
  "kind": "usecase",
  "name": "po-line-items",
  "title": "Purchase order line items",
  "description": "Drop in a purchase order as text and list the PO number, tax ids, HSN/SAC codes, the line-item lines and the amounts.",
  "accepts": [
    "txt"
  ],
  "extract": "text",
  "summary": [
    {
      "kind": "regex_extract",
      "title": "PO number",
      "pattern": "(?i)\\bPO(?: ?(?:no|number|#))?[.:# ]+([A-Z0-9][A-Z0-9/-]{2,})",
      "max_matches": 3,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "GSTINs seen",
      "pattern": "\\b([0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z])\\b",
      "max_matches": 6,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "HSN / SAC codes (labelled)",
      "pattern": "(?i)\\b(?:HSN|SAC)[/ A-Z]*[:# ]+([0-9]{4,8})",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "HSN / SAC codes (in a table column)",
      "pattern": "(?m)^\\S+\\s+.+?\\s{2,}([0-9]{4,8})\\s{2,}[0-9]",
      "max_matches": 10,
      "group": 1
    },
    {
      "kind": "regex_extract",
      "title": "Lines with amounts",
      "pattern": "(?m)^(.*(?:Rs\\.?|INR|₹)\\s?[0-9].*)$",
      "max_matches": 15,
      "group": 1
    },
    {
      "kind": "keyword_sections",
      "title": "Headings and totals",
      "keywords": [
        "qty",
        "quantity",
        "unit price",
        "freight",
        "total"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Open points",
      "keywords": [
        "tbd",
        "to be confirmed",
        "not specified",
        "pending"
      ],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Amounts",
      "pattern": "(?:₹|Rs\\.?|INR|USD|EUR|GBP|\\$|€|£)\\s?[0-9][0-9,]*(?:\\.[0-9]{2})?",
      "max_matches": 15
    }
  ],
  "artifact_title": "po-lines.md",
  "sample_file": "sample.txt"
}
