{
  "fabric-api": {
    "host": "127.0.0.1",
    "header": "authorization",
    "env": "FABRIC_API_TOKEN",
    "prefix": "Bearer ",
    "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
    "path_prefixes": ["/api/", "/readyz", "/health"],
    "allowed_ports": [9095],
    "requires_approval": ["POST", "PUT", "DELETE"],
    "approval_kind": "send"
  }
}
