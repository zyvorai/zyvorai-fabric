{
  "kind": "usecase",
  "name": "status-page-watch",
  "title": "Status page watch",
  "description": "Drop in a saved vendor status page (HTML) and see what is down, degraded, under maintenance or recovered.",
  "accepts": [
    "html",
    "htm"
  ],
  "extract": "html",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Down",
      "keywords": [
        "outage",
        "major",
        "is down",
        "unavailable",
        "investigating"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Degraded",
      "keywords": [
        "degraded",
        "partial",
        "elevated error",
        "delays",
        "slow"
      ],
      "max_lines": 8
    },
    {
      "kind": "keyword_sections",
      "title": "Maintenance",
      "keywords": [
        "scheduled maintenance",
        "maintenance window",
        "planned"
      ],
      "max_lines": 5
    },
    {
      "kind": "keyword_sections",
      "title": "Recovered",
      "keywords": [
        "resolved",
        "recovered",
        "all systems operational",
        "back to normal"
      ],
      "max_lines": 5
    },
    {
      "kind": "regex_extract",
      "title": "Times mentioned",
      "pattern": "([0-9]{1,2}:[0-9]{2} ?UTC)",
      "group": 1,
      "max_matches": 8
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "status.md",
  "sample_file": "sample.html"
}
