{
  "gmail-read": {
    "host": "gmail.googleapis.com",
    "header": "authorization",
    "kind": "oauth-refresh",
    "prefix": "Bearer ",
    "allowed_methods": [
      "GET"
    ],
    "path_prefixes": [
      "/gmail/v1/users/me/"
    ],
    "oauth": {
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN"
    }
  },
  "gmail-draft": {
    "host": "gmail.googleapis.com",
    "header": "authorization",
    "kind": "oauth-refresh",
    "prefix": "Bearer ",
    "allowed_methods": [
      "POST"
    ],
    "path_prefixes": [
      "/gmail/v1/users/me/drafts$"
    ],
    "requires_approval": [
      "POST"
    ],
    "approval_kind": "send",
    "require_device_signature": true,
    "oauth": {
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN"
    },
    "preview": "gmail-message"
  },
  "gmail-send": {
    "host": "gmail.googleapis.com",
    "header": "authorization",
    "kind": "oauth-refresh",
    "prefix": "Bearer ",
    "allowed_methods": [
      "POST"
    ],
    "path_prefixes": [
      "/gmail/v1/users/me/messages/send$"
    ],
    "requires_approval": [
      "POST"
    ],
    "approval_kind": "send",
    "require_device_signature": true,
    "preview": "gmail-message",
    "oauth": {
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN"
    }
  },
  "calendar-read": {
    "host": "www.googleapis.com",
    "header": "authorization",
    "kind": "oauth-refresh",
    "prefix": "Bearer ",
    "allowed_methods": [
      "GET"
    ],
    "path_prefixes": [
      "/calendar/v3/"
    ],
    "oauth": {
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN"
    }
  },
  "calendar-write": {
    "host": "www.googleapis.com",
    "header": "authorization",
    "kind": "oauth-refresh",
    "prefix": "Bearer ",
    "allowed_methods": [
      "POST"
    ],
    "path_prefixes": [
      "/calendar/v3/calendars/primary/events$"
    ],
    "requires_approval": [
      "POST"
    ],
    "approval_kind": "send",
    "require_device_signature": true,
    "preview": "calendar-event",
    "oauth": {
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN"
    }
  }
}
