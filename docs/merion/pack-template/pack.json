{
  "kind": "usecase",
  "name": "my-pack",
  "title": "My pack",
  "description": "Drop in a <thing> and get <the three things a person wants from it>.",
  "accepts": ["txt"],
  "extract": "text",
  "sample_file": "sample.txt",
  "summary": [
    {
      "kind": "keyword_sections",
      "title": "Totals",
      "keywords": ["total", "amount due"],
      "max_lines": 8
    },
    {
      "kind": "regex_extract",
      "title": "Dates",
      "pattern": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b",
      "max_matches": 8
    },
    {
      "kind": "stats",
      "title": "Size"
    }
  ],
  "artifact_title": "my-pack.md"
}
