{
  "cases": [
    {
      "name": "everything fits with headroom",
      "input": {
        "hosts": [
          {
            "name": "h1",
            "vcpus": 16,
            "memory_mb": 32768,
            "disk_gb": 500
          }
        ],
        "existing": [
          {
            "host": null,
            "vcpus": 4,
            "memory_mb": 8192,
            "disk_gb": 100
          }
        ],
        "new_vms": [
          {
            "name": "web",
            "vcpus": 2,
            "memory_mb": 4096,
            "disk_gb": 40,
            "count": 3
          }
        ],
        "overcommit": {
          "cpu_ratio": 1.0,
          "memory_ratio": 1.0,
          "storage_ratio": 1.0
        }
      },
      "expected": {
        "requested": 3,
        "fitted": 3,
        "all_fit": true,
        "placements": [
          {
            "name": "web",
            "index": 1,
            "host": "h1"
          },
          {
            "name": "web",
            "index": 2,
            "host": "h1"
          },
          {
            "name": "web",
            "index": 3,
            "host": "h1"
          }
        ],
        "unplaced": [],
        "hosts": [
          {
            "name": "h1",
            "effective": {
              "vcpus": 16,
              "memory_mb": 32768,
              "disk_gb": 500
            },
            "used_before": {
              "vcpus": 4,
              "memory_mb": 8192,
              "disk_gb": 100
            },
            "used_after": {
              "vcpus": 10,
              "memory_mb": 20480,
              "disk_gb": 220
            },
            "headroom_after": {
              "vcpus": 6,
              "memory_mb": 12288,
              "disk_gb": 280
            }
          }
        ]
      }
    },
