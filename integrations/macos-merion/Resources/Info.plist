<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Solvor</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Solvor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.zyvor.solvor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>keep</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Solvor reads the email you have open in your browser, only when you ask it to.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Approvals are signed with your fingerprint.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2026 Zyvor. Apache-2.0.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Solvor listens when you press the microphone button, to hear a command.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Send to Keep</string>
			</dict>
			<key>NSMessage</key>
			<string>sendToMerion</string>
			<key>NSPortName</key>
			<string>Solvor</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Solvor turns what you say into text, on this Mac when your language allows it, to understand a command.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Keep tells you when a run finishes or needs your approval.</string>
</dict>
</plist>
